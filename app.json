{
  "expo": {
    "name": "QualysBridge",
    "slug": "qualys-bridge",
    "scheme": "qualysbridge",
    "version": "1.0.0",
    "sdkVersion": "56.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070F",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07070F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qualys.bridge",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07070F"
      },
      "package": "com.qualys.bridge",
      "versionCode": 1
    },
    "plugins": [
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "2a26d79c-9e7b-4785-b2e8-396e912c92ae"
      }
    },
    "owner": "ruth1233"
  }
}
